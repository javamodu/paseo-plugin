{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "capsule-final-contract-v1",
  "title": "Capsule final baseline",
  "definitions": {
    "Capsule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "repoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "scopePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schemaVersion": {
          "const": 1
        }
      },
      "required": [
        "id",
        "goal",
        "repoId",
        "sourceCommit",
        "scopePaths",
        "schemaVersion"
      ]
    },
    "PlanNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": [
            "prepare",
            "coder",
            "evaluator",
            "reviewer"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "acceptanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "role",
        "dependsOn",
        "acceptanceId"
      ]
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capsuleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "planHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recipeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluatorHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/PlanNode"
          }
        }
      },
      "required": [
        "id",
        "capsuleId",
        "version",
        "planHash",
        "recipeVersion",
        "policyHash",
        "evaluatorHash",
        "nodes"
      ]
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "runtime": {
          "type": "string",
          "enum": [
            "paseo",
            "completion"
          ]
        },
        "providerModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "promptHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "toolSchemaHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capabilityReceiptHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "type": "string",
          "enum": [
            "manager",
            "coder",
            "reviewer"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "runtime",
        "providerModel",
        "promptHash",
        "toolSchemaHash",
        "capabilityReceiptHash",
        "purpose"
      ]
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxWorkers": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttemptsPerNode": {
          "type": "integer",
          "minimum": 1
        },
        "wallClockSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxReservedTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxSpendMicros": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "maxWorkers",
        "maxAttemptsPerNode",
        "wallClockSeconds",
        "maxReservedTokens",
        "maxSpendMicros"
      ]
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "planId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profileHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "DRAFT",
            "READY",
            "RUNNING",
            "VERIFYING",
            "WAITING_APPROVAL",
            "PAUSED",
            "CANCEL_REQUESTED",
            "CANCELLED",
            "FAILED",
            "UNKNOWN_EXTERNAL_STATE",
            "ACCEPTED"
          ]
        },
        "dispatchPaused": {
          "type": "boolean"
        },
        "limits": {
          "$ref": "#/definitions/Limits"
        },
        "candidateHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "planId",
        "profileHash",
        "version",
        "state",
        "dispatchPaused",
        "limits",
        "candidateHash"
      ]
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "INTENT",
            "STARTING",
            "RUNNING",
            "CANDIDATE_READY",
            "VERIFYING",
            "SUCCEEDED",
            "FAILED",
            "CANCEL_REQUESTED",
            "CANCELLED",
            "UNKNOWN_EXTERNAL_STATE"
          ]
        },
        "inputManifestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidateHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalSessionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "fencingToken": {
          "type": "integer",
          "minimum": 1
        },
        "usageState": {
          "type": "string",
          "enum": [
            "KNOWN",
            "ESTIMATED",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "id",
        "runId",
        "nodeId",
        "number",
        "state",
        "inputManifestHash",
        "candidateHash",
        "externalSessionId",
        "fencingToken",
        "usageState"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attemptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "candidateHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluatorHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environmentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "exitCode": {
          "type": "integer"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "testCount": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "attemptId",
        "candidateHash",
        "evaluatorHash",
        "environmentHash",
        "artifactHash",
        "exitCode",
        "verdict",
        "testCount",
        "createdAt"
      ]
    },
    "Approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "planHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidateHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "policyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "action": {
          "type": "string",
          "enum": [
            "ACCEPT_RESULT",
            "EXTEND_BUDGET",
            "REPLAN"
          ]
        },
        "expectedRunVersion": {
          "type": "integer",
          "minimum": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED",
            "REVOKED"
          ]
        },
        "actor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "runId",
        "planHash",
        "candidateHash",
        "policyHash",
        "action",
        "expectedRunVersion",
        "expiresAt",
        "decision",
        "actor"
      ]
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "PROPOSE_PLAN",
            "APPROVE_PLAN",
            "START_RUN",
            "MESSAGE_MANAGER",
            "PAUSE_RUN",
            "RESUME_RUN",
            "CANCEL_RUN",
            "GLOBAL_STOP",
            "CLEAR_STOP",
            "RERUN",
            "DECIDE_APPROVAL",
            "UPDATE_PROFILE"
          ]
        },
        "expectedVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "runId",
        "kind",
        "expectedVersion",
        "payloadHash",
        "payload"
      ]
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "structuredOutput": {
          "type": "boolean"
        },
        "usage": {
          "type": "boolean"
        },
        "cancel": {
          "type": "boolean"
        },
        "correlationLookup": {
          "type": "boolean"
        },
        "sandboxEstablished": {
          "type": "boolean"
        },
        "nestedVisibility": {
          "type": "boolean"
        },
        "probeReceiptHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "runtimeId",
        "version",
        "structuredOutput",
        "usage",
        "cancel",
        "correlationLookup",
        "sandboxEstablished",
        "nestedVisibility",
        "probeReceiptHash"
      ]
    },
    "Trial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profileHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "started": {
          "type": "boolean"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "TIMEOUT",
            "NOT_RUN"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "knownCostMicros": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsedMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "caseId",
        "profileHash",
        "repeat",
        "started",
        "verdict",
        "attempts",
        "knownCostMicros",
        "elapsedMs",
        "evidenceHash"
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "CAPSULE_CREATED",
            "PLAN_PROPOSED",
            "PLAN_APPROVED",
            "RUN_CREATED",
            "COMMAND_ACCEPTED",
            "DISPATCH_RESERVED",
            "SESSION_BOUND",
            "CAPACITY_WAIT",
            "RUNTIME_OBSERVED",
            "CANDIDATE_FROZEN",
            "EVIDENCE_RECORDED",
            "REPAIR_REQUESTED",
            "APPROVAL_REQUESTED",
            "APPROVAL_DECIDED",
            "APPROVAL_REVOKED",
            "BUDGET_RESERVED",
            "BUDGET_SETTLED",
            "USAGE_UNKNOWN",
            "PAUSE_REQUESTED",
            "RUN_RESUMED",
            "STOP_LATCH_SET",
            "STOP_LATCH_CLEARED",
            "CANCEL_REQUESTED",
            "CANCEL_CONFIRMED",
            "EXTERNAL_STATE_UNKNOWN",
            "RUN_ACCEPTED",
            "RUN_FAILED",
            "NODE_SKIPPED",
            "PROFILE_PUBLISHED",
            "EVAL_TRIAL_RECORDED",
            "RESTORE_RECONCILED"
          ]
        },
        "runId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "causationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "sequence",
        "type",
        "runId",
        "attemptId",
        "causationId",
        "actorId",
        "createdAt",
        "payload"
      ]
    }
  }
}
